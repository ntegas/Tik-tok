# LLM
ANTHROPIC_API_KEY=

# YouTube Data API (используется для чтения трендов, ключ без OAuth)
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=RU

# Telegram Bot API (публикация постов в канал/чат)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TikTok Content Posting API — требует одобрения приложения в TikTok for Developers
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Instagram Graph API — требует Business/Creator аккаунт и Facebook App Review
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# YouTube Data API OAuth (для загрузки видео, отдельно от YOUTUBE_API_KEY выше)
YOUTUBE_OAUTH_CLIENT_SECRETS_FILE=
